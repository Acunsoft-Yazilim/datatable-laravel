{
    "name": "acunsoft/datatable-laravel",
    "description": "Laravel and Livewire for Acun DataTable: an allowlisted, Turkish-aware Eloquent query layer, a JSON endpoint for the HTTP data source and a Livewire table trait with accessible Blade views.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://acunsoft-yazilim.github.io/acun-datatable/",
    "authors": [
        {
            "name": "Kemal OSKAN",
            "homepage": "https://github.com/kemaloskan"
        }
    ],
    "support": {
        "issues": "https://github.com/Acunsoft-Yazilim/acun-datatable/issues",
        "source": "https://github.com/kemaloskan/datatable-laravel",
        "docs": "https://acunsoft-yazilim.github.io/acun-datatable/#/laravel"
    },
    "keywords": [
        "laravel",
        "eloquent",
        "datatable",
        "acun-datatable"
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0 || ^13.0"
    },
    "require-dev": {
        "livewire/livewire": "^4.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "suggest": {
        "livewire/livewire": "^4.0 — for the WithDataTable Livewire trait and its views",
        "ext-intl": "for locale-aware number and date text and exact accent folding",
        "ext-zip": "Needed to export and import Excel (.xlsx) files."
    },
    "autoload": {
        "psr-4": {
            "Acunsoft\\DataTable\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acunsoft\\DataTable\\Laravel\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Acunsoft\\DataTable\\Laravel\\DataTableServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
